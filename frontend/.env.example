# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend API URL
# Leave empty in local dev to use Vite proxy (/api → localhost:3000) and HttpOnly auth cookies.
# VITE_API_URL=http://localhost:3000

# Optional: FX rates API key — prefer proxying through backend in production (key is bundled in client).
# VITE_FX_API_KEY=
