# Copy to `.env`. Must match backend `INTERNAL_API_SECRET` when that is set.

# Backend (Node) URL used for catalog / orders / leads internal API
BACKEND_URL=http://localhost:3000

# Same random string as backend INTERNAL_API_SECRET (required when backend runs in production)
INTERNAL_API_SECRET=

# Must match backend AI_SERVICE_SECRET. Required unless ELVA_DEV_INSECURE=1 (local dev only).
AI_SERVICE_SECRET=

# Set to 1 only for local dev when you intentionally skip AI_SERVICE_SECRET (never in production).
# ELVA_DEV_INSECURE=1

# LLM keys (see llm_provider.py)
GROQ_API_KEY=
