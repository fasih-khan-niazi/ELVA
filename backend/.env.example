# ELVA Backend — environment template (copy to .env and fill values)

# Server
PORT=3000
BASE_URL=https://your-ngrok-or-domain.example
MONGO_URI=mongodb://localhost:27017/elva
JWT_SECRET=change-me

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=change-me
INTERNAL_API_SECRET=change-me

# Google OAuth (backend verifies ID tokens — must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Set to 1 only for local dev when INTERNAL_API_SECRET is intentionally unset (never in production).
# ELVA_DEV_INSECURE=1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# Voice pipeline (Media Streams — required)
ENABLE_MEDIA_STREAMS=true
ENABLE_BROWSER_MEDIA_STREAMS=true
ENABLE_VOICE_STREAMING=true

# Latency tuning (PK / South Asia defaults)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Optional keyword boost for nova-2 (word:intensifier pairs, comma-separated)
# DEEPGRAM_KEYWORDS=Niazi:2,Niazi Foods:2,sweets:1,barbecue:1
DEEPGRAM_ENDPOINTING_MS=400
VOICE_UTTERANCE_DEBOUNCE_MS=900
VOICE_UTTERANCE_DEBOUNCE_PHONE_MS=3500
VOICE_UTTERANCE_DEBOUNCE_INCOMPLETE_EXTRA_MS=1200
VOICE_SILENCE_PROMPT_MS=12000
VOICE_FILLERS_ENABLED=true
VOICE_AI_TIMEOUT_MS=25000
VOICE_AI_FIRST_SENTENCE_MS=18000

# Azure TTS (centralindia recommended for PK latency)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE=en-US-JennyNeural

# Concurrent voice calls per plan (override optional)
# VOICE_MAX_CONCURRENT_PRO=3
# VOICE_MAX_CONCURRENT_ENTERPRISE=10

# Supabase, Stripe, SendGrid — add as needed
